 public static int diagonalDifference(List<List<Integer>> arr) 
{
        int sum1=0;
        int sum2=0;
        int n=arr.size();
        for(int i=0;i<n;i++)
        {
            sum1+=arr.get(i).get(i);  //in this case i == j
            sum2+=arr.get(i).get(n-1-i);    //in this case j = n-i-1
        }
        int diff = Math.abs(sum1-sum2);
        return diff;
    }
